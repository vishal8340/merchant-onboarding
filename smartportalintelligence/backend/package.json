{
  "name": "merchant-onboarding-backend",
  "version": "1.0.0",
  "scripts": {
    "kill": "pkill -f 'ts-node|nodemon|mcc-analyser|smart-risk-scoring' 2>/dev/null; lsof -ti tcp:8080 | xargs kill -9 2>/dev/null; lsof -ti tcp:8091 | xargs kill -9 2>/dev/null; lsof -ti tcp:3001 | xargs kill -9 2>/dev/null; echo 'All services killed'",
    "restart": "npm run kill && sleep 2 && npm run dev:all",
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:all": "concurrently --names \"backend,mcc-analyser,risk-scoring,frontend\" --prefix-colors \"cyan,green,yellow,magenta\" \"npm run dev\" \"npm run mcc-analyser\" \"npm run smart-risk-scoring\" \"cd ../frontend && BROWSER=none npm start\"",
    "mcc-analyser": "cd ../mcc-analyser && API_KEY=dial-ftwcbhgzau3w9ogooz3rt9mmdho /Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home/bin/java -jar target/mcc-analyser-1.0.0-SNAPSHOT.jar",
    "smart-risk-scoring": "cd ../smart-risk-scoring && /Library/Java/JavaVirtualMachines/temurin-25.jdk/Contents/Home/bin/java -jar target/smart-risk-scoring-1.0.0.jar --openai.api.key=dial-ftwcbhgzau3w9ogooz3rt9mmdho",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:textract": "ts-node src/scripts/testTextract.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
    "@aws-sdk/client-sts": "^3.1034.0",
    "@aws-sdk/client-textract": "^3.1034.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "amqplib": "^0.10.3",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "gpt-tokenizer": "^3.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "multer": "^2.1.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.1",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1",
    "pdfkit": "^0.18.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
